@inherits LayoutComponentBase
@using System.Security.Claims
@using TP6Programacion.Web.Components

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Siguiendo un poco con la explicación que te di en EstadoAutenticacionProvider contactamos a este provider y a lo que nos retorna
lo guardamos en la variable estado (termina siendo el usuario a fin de cuentas)*@
<AuthorizeView Context="estado">
    <Authorized>
        <div class="page">
            <main>
                <div class="top-row px-4">
                    <span>@estado.User.Identity?.Name (@estado.User.FindFirst(ClaimTypes.Role)?.Value)</span>
                    <BotonCerrarSesion />
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>

    <NotAuthorized>
        <article class="content px-4">
            @Body
        </article>
    </NotAuthorized>
</AuthorizeView>
