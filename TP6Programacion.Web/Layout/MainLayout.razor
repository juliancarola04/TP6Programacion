@inherits LayoutComponentBase
@using System.Security.Claims
@using TP6Programacion.Web.Components

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Siguiendo un poco con la explicación que te di en EstadoAutenticacionProvider contactamos a este provider y a lo que nos retorna
lo guardamos en la variable estado (termina siendo el usuario a fin de cuentas)*@
<AuthorizeView Context="estado">
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1"
                       Style="background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary);">

                <AuthorizeView Roles="Administrador" Context="permisosBarra">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Inherit"
                                   Edge="Edge.Start"
                                   OnClick="AlternarMenu" />
                </AuthorizeView>

                <MudText Typo="Typo.h6">TP6Programacion.Web</MudText>

                <MudSpacer />

                <MudText Class="mr-3">
                    @estado.User.Identity?.Name (@estado.User.FindFirst(ClaimTypes.Role)?.Value)
                </MudText>

                <BotonCerrarSesion />
            </MudAppBar>

            <AuthorizeView Roles="Administrador" Context="permisosMenu">
                <MudDrawer @bind-Open="_menuAbierto"
                           Variant="DrawerVariant.Responsive"
                           ClipMode="DrawerClipMode.Always"
                           Elevation="1"
                           Width="250px">
                    <NavMenu />
                </MudDrawer>
            </AuthorizeView>

            <MudMainContent>
                <div class="pa-4">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>

    <NotAuthorized>
        <article class="content px-4">
            @Body
        </article>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _menuAbierto = true;

    private void AlternarMenu()
    {
        _menuAbierto = !_menuAbierto;
    }
}