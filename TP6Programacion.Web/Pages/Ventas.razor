@page "/ventas"
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using TP6Programacion.Shared.DTO.Venta.Response
@using TP6Programacion.Web.Services
@attribute [Authorize(Roles = "Administrador")]
@inject VentasService VentasService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Ventas</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h5" GutterBottom="true">Ventas</MudText>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>

        <MudButton Disabled="_cargando" OnClick="Cargar">
            Reintentar
        </MudButton>
    }

    <MudTable T="VentaListadoResponse" Items="_ventas"
              Loading="_cargando" Hover="true" RowsPerPage="10">
        <HeaderContent>
            <MudTh>Número</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Número">@context.Id</MudTd>
            <MudTd DataLabel="Fecha">
                @context.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </MudTd>
            <MudTd DataLabel="Cliente">@(context.ClienteNombre ?? "Consumidor Final")</MudTd>
            <MudTd DataLabel="Estado">@context.Estado</MudTd>
            <MudTd DataLabel="Total">@context.Total.ToString("C2", _cultura)</MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Color="Color.Primary"
                           Disabled="_descargando"
                           OnClick="@(() => DescargarPdf(context.Id))">
                    Descargar PDF
                </MudButton>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No hay ventas para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>

    @if (_totalPaginas > 1)
    {
        <MudPagination Count="_totalPaginas"
                       Selected="_pagina"
                       SelectedChanged="CambiarPagina"
                       Disabled="_cargando"
                       Color="Color.Primary"
                       Class="mt-4" />
    }
</MudContainer>

@code {
    private readonly CultureInfo _cultura = CultureInfo.GetCultureInfo("es-AR");
    private List<VentaListadoResponse> _ventas = new();
    private int _pagina = 1;
    private int _totalPaginas;
    private bool _cargando;
    private string? _error;
    private bool _descargando;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task DescargarPdf(int ventaId)
    {
        if (_descargando)
        {
            return;
        }

        _descargando = true;

        try
        {
            byte[] pdf = await VentasService.ObtenerComprobante(ventaId);

            await JS.InvokeVoidAsync("descargarPdf", $"Venta-{ventaId}.pdf", pdf);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo descargar el comprobante.", Severity.Error);
        }
        catch (InvalidOperationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        catch (JSException)
        {
            Snackbar.Add("No se pudo iniciar la descarga del archivo.", Severity.Error);
        }
        finally
        {
            _descargando = false;
        }
    }

    private async Task Cargar()
    {
        if (_cargando)
        {
            return;
        }

        _cargando = true;
        _error = null;

        try
        {
            var resultado = await VentasService.ObtenerVentas(_pagina);

            _ventas = resultado.Datos;
            _pagina = resultado.NumeroPagina;
            _totalPaginas = resultado.TotalPaginas;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron consultar las ventas.";
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CambiarPagina(int pagina)
    {
        if (_cargando)
        {
            return;
        }

        _pagina = pagina;
        await Cargar();
    }
}