@using TP6Programacion.Shared.Auth
@inherits LayoutComponentBase
@using System.Net
@using TP6Programacion.Mobile.Services
@using TP6Programacion.Shared.DTO.Auth.Response
@inject AutenticacionService AutenticacionService
@inject AlmacenamientoTokensService AlmacenamientoTokensService
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_cargando)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudStack Class="pa-6" Spacing="3">
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarSesion">
            Reintentar
        </MudButton>
    </MudStack>
}
else if (_autorizado)
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <span>@_usuario?.Username (@_usuario?.Rol)</span>
                <BotonCerrarSesion />
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

@code {
    private bool _cargando = true;
    private bool _autorizado;
    private UsuarioSesion? _usuario;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarSesion();
    }

    private async Task CargarSesion()
    {
        _cargando = true;
        _autorizado = false;
        _error = null;

        try
        {
            LoginResponse? sesion = await AlmacenamientoTokensService.Obtener();

            if (sesion is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            _usuario = await AutenticacionService.ObtenerUsuarioSesion();
            _autorizado = true;
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                AlmacenamientoTokensService.Limpiar();
                Navigation.NavigateTo("/login");
            }
            else
            {
                _error = "No se pudo recuperar la sesión. Intentá nuevamente.";
            }
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
