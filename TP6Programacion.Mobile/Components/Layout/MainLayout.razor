@inherits LayoutComponentBase
@using System.Security.Claims

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView Context="estado">
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1"
                       Style="background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary);">

                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="AbrirMenu" />

                <MudText Typo="Typo.h6">
                    TP6Programacion
                </MudText>
            </MudAppBar>

            <MudDrawer @bind-Open="_menuAbierto"
                       Variant="DrawerVariant.Temporary"
                       Elevation="2"
                       Width="260px">

                <MudDrawerHeader>
                    <MudText Typo="Typo.h6">Menú</MudText>

                    <MudSpacer />

                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   OnClick="CerrarMenu" />
                </MudDrawerHeader>

                <div @onclick="CerrarMenu">
                    <NavMenu />
                </div>

                <MudDivider />

                <div class="pa-4">
                    <MudText Typo="Typo.subtitle1">
                        @estado.User.Identity?.Name
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @estado.User.FindFirst(ClaimTypes.Role)?.Value
                    </MudText>

                    <BotonCerrarSesion />
                </div>
            </MudDrawer>

            <MudMainContent>
                <div class="pa-4">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>

    <NotAuthorized>
        <article class="content px-4">
            @Body
        </article>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _menuAbierto;

    private void AbrirMenu()
    {
        _menuAbierto = true;
    }

    private void CerrarMenu()
    {
        _menuAbierto = false;
    }
}