@inject TP6Programacion.Mobile.Services.EstadoAutenticacionProvider Estado
@using TP6Programacion.Mobile.Components

<Router AppAssembly="@typeof(MauiProgram).Assembly"
        NotFoundPage="typeof(Pages.NotFound)"
        OnNavigateAsync="AlNavegar">

    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData"
                            DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <p>No iniciaste sesión o no tenés permisos para esta página.</p>
                <RedirectToLogin />
            </NotAuthorized>

            <Authorizing>
                <p>Comprobando sesión...</p>
            </Authorizing>
        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private async Task AlNavegar(
        Microsoft.AspNetCore.Components.Routing.NavigationContext contexto)
    {
        // NO TOCAR ESTO SOL. SI LO TOCÁS DESPUÉS NO VA A VOLVER A COMPROBAR 👎
        contexto.CancellationToken.ThrowIfCancellationRequested();

        await Estado.Actualizar();

        contexto.CancellationToken.ThrowIfCancellationRequested();
    }
}
